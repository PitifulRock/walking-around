[animation]

warnings/check_invalid_track_paths=false
warnings/check_angle_interpolation_type_conflicting=false

[application]

config/name="walking around"
run/main_scene="uid://c1nnke8268xxy"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Master="*res://scripts/master.gd"
SettingsManager="*res://scripts/settings_manager.gd"
SimpleGrass="*res://addons/simplegrasstextured/singleton.tscn"
Console="*res://scenes/DebugConsole.tscn"

[display]

window/size/viewport_width=1366
window/size/viewport_height=768
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/anthonyec.camera_preview/plugin.cfg", "res://addons/simplegrasstextured/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://entities/": "pink",
"res://items/": "pink",
"res://models/": "purple",
"res://scenes/": "green",
"res://scripts/": "green",
"res://shaders/": "purple",
"res://sound/": "purple",
"res://textures/": "purple"
}

